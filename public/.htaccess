<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 301 Redirect for legacy affiliate-onboarding URL indexed by Google
  RewriteRule ^affiliate-onboarding(\.html)?$ /onboarding [R=301,L]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>
